---
import { loadElo, type EloDoc } from '../lib/data';

// `retired` selects which set to render: the active roster (default) or the
// retired models. The retired variant drops the rank column (a global rank is
// misleading for models no longer competing) and renders subdued.
const { retired = false } = Astro.props;

const elo: EloDoc = loadElo();
const rows = Object.entries(elo.models)
  .filter(([, m]) => Boolean(m.retired) === retired)
  .map(([id, m]) => ({ id, ...m }))
  .sort((a, b) => b.rating - a.rating);

// Org-hosted product or model card for each entry in the lineup.
// Falls back to displaying just the name if no URL is known. Includes the current
// roster plus retired models that still hold Elo history.
const MODEL_URLS: Record<string, string> = {
  // Anthropic
  'claude-opus-4-7-thinking':        'https://www.anthropic.com/claude/opus',
  'claude-opus-4-7':                 'https://www.anthropic.com/claude/opus',
  // Google
  'gemini-3.1-pro-preview':          'https://deepmind.google/models/gemini/pro/',
  'gemini-2.5-pro':                  'https://deepmind.google/models/gemini/pro/',
  // OpenAI
  'gpt-5.5':                         'https://openai.com/index/introducing-gpt-5-5/',
  // xAI
  'grok-4.20-beta-0309-reasoning':   'https://docs.x.ai/developers/models',
  'grok-4.3':                        'https://docs.x.ai/developers/models/grok-4.3',
  // ByteDance (via BytePlus ModelArk)
  'seed-2-0-pro-260328':             'https://seed.bytedance.com/',
  // Moonshot
  'kimi-k2.6':                       'https://platform.moonshot.ai/',
  // Retired (historical rows; hidden from the table but kept for reference)
  'mistral-large-2512':              'https://docs.mistral.ai/models/model-cards/mistral-large-3-25-12',
  'mistral-medium-3.5':              'https://docs.mistral.ai/models/model-cards/mistral-medium-3-5-26-04',
};
---
<table class={retired ? 'retired' : undefined}>
  <thead>
    <tr>{!retired && <th>#</th>}<th>Model</th><th>Org</th><th>Elo</th><th>Games</th><th>Wins</th></tr>
  </thead>
  <tbody>
    {rows.map((r, i) => (
      <tr>
        {!retired && <td class="rank">{i + 1}</td>}
        <td>
          {MODEL_URLS[r.id] ? (
            <a class="model-link" href={MODEL_URLS[r.id]} target="_blank" rel="noopener">{r.display_name}</a>
          ) : (
            r.display_name
          )}
        </td>
        <td class="muted">{r.org}</td>
        <td class="num elo">{Math.round(r.rating)}<span class="rd">&#8201;&plusmn;&#8201;{Math.round(r.rd)}</span></td>
        <td class="num">{r.games}</td>
        <td class="num">{r.wins}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
table { width: 100%; border-collapse: collapse; font: 16px/1.5 ui-monospace, Menlo, monospace; }
th, td { padding: 12px 14px; text-align: left; border-bottom: 1px solid #1d2128; }
th { color: #7a8290; font-weight: 400; letter-spacing: .14em; text-transform: uppercase; font-size: 12px; }
tbody tr:hover { background: rgba(255, 255, 255, 0.03); }
.num { text-align: right; font-variant-numeric: tabular-nums; }
.rank { color: #7a8290; width: 32px; }
.muted { color: #7a8290; }
.elo { font-weight: 600; }
.rd { color: #7a8290; font-weight: 400; font-size: 0.82em; }
.model-link { color: inherit; text-decoration: none; }
.model-link:hover { color: #f0d680; text-decoration: underline; text-underline-offset: 3px; }

/* Retired models render subdued to set them apart from the live roster. */
table.retired { color: #7a8290; }
table.retired .elo { font-weight: 400; }

/* Narrow phones: shrink the table and hide the Org column (3rd) so
   the model name doesn't get squeezed. */
@media (max-width: 600px) {
  table { font-size: 14px; }
  th, td { padding: 8px 6px; }
  /* Hide the Org column: 3rd in the active table (after #, Model), 2nd in the
     retired table (no rank column). */
  table:not(.retired) th:nth-child(3), table:not(.retired) td:nth-child(3) { display: none; }
  table.retired th:nth-child(2), table.retired td:nth-child(2) { display: none; }
}
@media (max-width: 380px) {
  table { font-size: 13px; }
}
</style>
