---
import { loadElo, type EloDoc } from '../lib/data';
const elo: EloDoc = loadElo();
const rows = Object.entries(elo.models)
  .map(([id, m]) => ({ id, ...m }))
  .sort((a, b) => b.rating - a.rating);
---
<table>
  <thead>
    <tr><th>#</th><th>Model</th><th>Org</th><th>Elo</th><th>Games</th><th>Wins</th></tr>
  </thead>
  <tbody>
    {rows.map((r, i) => (
      <tr>
        <td class="rank">{i + 1}</td>
        <td>{r.display_name}</td>
        <td class="muted">{r.org}</td>
        <td class="num elo">{Math.round(r.rating)}</td>
        <td class="num">{r.games}</td>
        <td class="num">{r.wins}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
table { width: 100%; border-collapse: collapse; font: 16px/1.5 ui-monospace, Menlo, monospace; }
th, td { padding: 12px 14px; text-align: left; border-bottom: 1px solid #1d2128; }
th { color: #7a8290; font-weight: 400; letter-spacing: .14em; text-transform: uppercase; font-size: 12px; }
tbody tr:hover { background: rgba(255, 255, 255, 0.03); }
.num { text-align: right; font-variant-numeric: tabular-nums; }
.rank { color: #7a8290; width: 32px; }
.muted { color: #7a8290; }
.elo { font-weight: 600; }

/* Narrow phones: shrink the table and hide the Org column (3rd) so
   the model name doesn't get squeezed. */
@media (max-width: 600px) {
  table { font-size: 14px; }
  th, td { padding: 8px 6px; }
  th:nth-child(3), td:nth-child(3) { display: none; }
}
@media (max-width: 380px) {
  table { font-size: 13px; }
}
</style>
