---
import CardImage from './CardImage.astro';
import type { TurnRecord } from '../lib/data';

interface Props { turn: TurnRecord; players: string[]; }
const { turn, players } = Astro.props;

const isSkipped = turn.clue === null;

// Standard competition ranking ("1224"): a player's rank is 1 + the number of
// players strictly ahead on running total, so ties share a rank.
const totals = turn.scores_total;
const rankOf = (p: string) =>
  1 + players.filter(q => (totals[q] ?? 0) > (totals[p] ?? 0)).length;
---
<article>
  <header>
    <span class="turn-no">turn {turn.turn + 1}</span>
    <span class="storyteller"><strong>{turn.storyteller}</strong></span>
    {isSkipped ? (
      <span class="skipped">— forfeited</span>
    ) : (
      <span class="clue">"{turn.clue}"</span>
    )}
  </header>

  {!isSkipped && (
    <div class="cards">
      {players.map(pid => {
        // Running score lives on the card itself, so the model name isn't
        // repeated in a separate row. Rank is a corner badge (mirroring the
        // storyteller tag); total + delta sit under the owner name.
        const rank = rankOf(pid);
        const delta = turn.scores_delta[pid] ?? 0;
        const rankBadge = <div class="rank-badge" data-leader={rank === 1}>#{rank}</div>;
        const scoreBlock = (
          <div class="card-score">
            <span class="total">{turn.scores_total[pid] ?? 0}</span>
            {delta !== 0 && (
              <span class={delta > 0 ? 'pos' : 'neg'}>{delta > 0 ? '+' : ''}{delta}</span>
            )}
          </div>
        );
        const cid = turn.submissions[pid];
        if (cid === undefined) {
          // Player sat out this turn (pick forfeit).
          return (
            <div class="card forfeit">
              {rankBadge}
              <div class="forfeit-marker">sat out</div>
              <div class="owner">{pid}</div>
              {scoreBlock}
            </div>
          );
        }
        const votes = Object.entries(turn.votes).filter(([, c]) => c === cid).map(([v]) => v);
        const isStoryteller = cid === turn.storyteller_card;
        return (
          <div class="card" data-storyteller={isStoryteller}>
            {isStoryteller && <div class="badge">STORYTELLER</div>}
            {rankBadge}
            <CardImage cardId={cid} size={160} />
            <div class="owner">{pid}</div>
            {scoreBlock}
            <div class="votes-block">
              <div class="votes-label">{votes.length === 0 ? 'no votes' : 'voted by'}</div>
              {votes.length > 0 && (
                <div class="pills">
                  {votes.map(v => (
                    <span class="pill" data-correct={isStoryteller}>{v}</span>
                  ))}
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  )}

  {isSkipped && (
    /* No cards render on a forfeited turn, so fall back to a compact row. */
    <div class="scores">
      {players.map(p => {
        const delta = turn.scores_delta[p] ?? 0;
        const rank = rankOf(p);
        return (
          <span class="score" data-leader={rank === 1}>
            <span class="rank">#{rank}</span>
            {p}: <strong>{turn.scores_total[p] ?? 0}</strong>
            {delta !== 0 && (
              <span class={delta > 0 ? 'pos' : 'neg'}> {delta > 0 ? '+' : ''}{delta}</span>
            )}
          </span>
        );
      })}
    </div>
  )}

  {turn.degraded.length > 0 && (
    <div class="degraded">⚠ {turn.degraded.join(', ')}</div>
  )}
</article>

<style>
article { border-bottom: 1px solid #1d2128; padding: 18px 0; }
header { display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; }
.turn-no { color: var(--muted); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; }
.clue { color: #f0d680; font-style: italic; }
.skipped { color: var(--muted); }

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, 176px);
  gap: 14px;
  margin: 14px 0;
}

.card {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 176px;
  padding: 8px;
  border-radius: 10px;
  border: 1px solid #1d2128;
  background: #131620;
  position: relative;
}
.card[data-storyteller] {
  border-color: #f0d680;
  background: rgba(240, 214, 128, 0.06);
  box-shadow: 0 0 0 1px rgba(240, 214, 128, 0.18);
}
.card.forfeit {
  background: #131620;
  border-style: dashed;
  opacity: 0.6;
  min-height: 268px;            /* roughly matches a populated card's height */
}
.forfeit-marker {
  color: var(--muted);
  font-size: 11px;
  letter-spacing: .14em;
  text-transform: uppercase;
  text-align: center;
  flex-grow: 1;
  display: grid;
  place-items: center;
}

.badge {
  position: absolute;
  top: -10px;
  left: 8px;
  background: #f0d680;
  color: #0f1115;
  font-weight: 700;
  font-size: 10px;
  letter-spacing: .14em;
  padding: 2px 8px;
  border-radius: 4px;
}

.owner {
  color: var(--fg);
  font-size: 12px;
  font-weight: 600;
  margin-top: 8px;
  /* Reserve two lines so a long model name that wraps (e.g.
     gemini-3.1-pro-preview) doesn't push its score and votes out of
     alignment with the other cards in the row. */
  min-height: 3em;
}

.card-score {
  display: flex;
  align-items: baseline;
  gap: 6px;
  margin-top: 3px;
  font-size: 12px;
}
.card-score .total { color: var(--fg); font-weight: 700; font-size: 15px; }

.rank-badge {
  position: absolute;
  top: -10px;
  right: 8px;
  background: #1d2128;
  color: var(--muted);
  font-weight: 700;
  font-size: 10px;
  letter-spacing: .08em;
  padding: 2px 7px;
  border-radius: 4px;
  border: 1px solid #2f3542;
}
.rank-badge[data-leader] {
  background: #f0d680;
  color: #0f1115;
  border-color: #f0d680;
}

.votes-block {
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid #1d2128;
}
.votes-label {
  color: var(--muted);
  font-size: 10px;
  letter-spacing: .14em;
  text-transform: uppercase;
  margin-bottom: 4px;
}
.pills {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}
.pill {
  font-size: 11px;
  padding: 2px 6px;
  border-radius: 4px;
  background: #232834;
  color: #c8cdd6;
  border: 1px solid #2f3542;
}
.pill[data-correct] {
  background: rgba(111, 207, 151, 0.18);
  color: var(--pos);
}

.scores { display: flex; gap: 12px; font-size: 12px; flex-wrap: wrap; margin-top: 8px; }
.rank { color: var(--muted); font-size: 11px; margin-right: 4px; }
.score[data-leader] { color: #f0d680; }
.score[data-leader] .rank { color: #f0d680; }
.pos { color: var(--pos); }
.neg { color: var(--neg); }
.degraded { color: var(--neg); font-size: 12px; margin-top: 6px; }
</style>
